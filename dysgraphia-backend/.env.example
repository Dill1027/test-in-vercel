NODE_ENV=development
HOST=0.0.0.0
PORT=5000
LOG_LEVEL=debug

# Comma-separated frontend origins
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Upload and model behavior
MAX_IMAGE_SIZE_MB=5
ML_CONFIDENCE_THRESHOLD=0.75
PREDICTOR_PROVIDER=mock
PREDICTOR_URL=http://127.0.0.1:8001/predict
# Optional; defaults to PREDICTOR_URL with /predict replaced by /health
PREDICTOR_HEALTH_URL=http://127.0.0.1:8001/health
PREDICTOR_HEALTH_TIMEOUT_MS=2000
MODEL_STARTUP_TIMEOUT_MS=120000
MODEL_STARTUP_POLL_INTERVAL_MS=500

# YOLO inference tuning (416 is faster; use 640 if accuracy needs it)
MODEL_IMAGE_SIZE=416
MODEL_DEVICE=cpu
MODEL_MAX_DETECTIONS=10

# Optional local Python interpreter; omit in Linux/container deployments
PYTHON_EXECUTABLE=

# Reset support for local testing
ENABLE_DEV_RESET=false

# Firebase Admin credentials
FIREBASE_PROJECT_ID=

# Option 1: full JSON string
FIREBASE_SERVICE_ACCOUNT_JSON=

# Option 2: path to service account JSON
FIREBASE_SERVICE_ACCOUNT_PATH=

# Option 3: individual fields
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Optional: application default credentials fallback
GOOGLE_APPLICATION_CREDENTIALS=
