# Flask digit-recognition API. Comma-separated origins are allowed.
FRONTEND_URL=http://localhost:5173
ML_PORT=4002
ML_SERVICE_URL=http://127.0.0.1:4002

# Existing Node/Mongo progress API in this folder.
PORT=4001
NODE_ENV=development
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority
MONGODB_DB_NAME=dyscalculia
CLIENT_ORIGIN=http://localhost:5173
