"dysgraphia-backend": {
  "root": "dysgraphia-backend",
  "framework": "express",
  "entrypoint": "src/app.js",
  "bindings": [
    {
      "type": "service",
      "service": "dysgraphia-model",
      "format": "url",
      "env": "DYSGRAPHIA_MODEL_URL"
    }
  ]
},
"dysgraphia-model": {
  "root": "dysgraphia-backend/src/models",
  "framework": "fastapi",
  "entrypoint": "app:app"
}